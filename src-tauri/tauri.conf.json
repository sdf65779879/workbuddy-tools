{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy 鑫杭加速",
  "version": "0.1.0",
  "identifier": "com.workbuddy.codex-gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorkBuddy 鑫杭加速",
        "width": 1280,
        "height": 860,
        "minWidth": 920,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
